# ============================================================
# Prism Engine v1.0 — 开源入库规则
# 原则：源码与文档入库；构建产物、中间产物、本地垃圾一律不入库。
# ============================================================

# ---- 构建产物 ----
/target/
**/target/
/target
**/*.wasm
*.wasm.map

# ---- 本地工作区（不入公开仓）----
.codebuddy/

# ---- 依赖目录（仅 playwright 浏览器驱动，非引擎依赖）----
node_modules/

# ---- 分发产物（TXT 包由打包脚本生成，不入库）----
/dist/

# ---- 本地备份与过程产物 ----
*.bak
*.md5
*.golden.tmp
*.orig
*.rej
# tools/backup.sh 的台账与快照：本地备份目录，不入公开仓
/tools/backups/

# ---- 编辑器 / 系统临时 ----
*.swp
*.swo
.DS_Store
Thumbs.db
.idea/
.vscode/

# ---- 私有本地覆盖（若有）----
.env
.env.local
# 本地预览临时文件
_preview*.html
